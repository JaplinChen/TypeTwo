# TypeTwo Server production 範本
# 請複製成 .env，替換所有範例值後再部署。

ENVIRONMENT=production
AUTO_CREATE_TABLES=false

# PostgreSQL
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

# JWT secret 至少 32 字元，建議使用密碼管理器產生。
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 初始管理員。首次部署後請改密碼並安全保存。
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Caddy / HTTPS
GLOSSARY_DOMAIN=typetwo-glossary.company.com
ACME_EMAIL=it-admin@company.com
PUBLIC_BASE_URL=https://typetwo-glossary.company.com

# 多個 origin 以逗號分隔；正式環境不可使用 *。
CORS_ALLOWED_ORIGINS=https://typetwo-glossary.company.com
